# Item Value Estimator Configuration
# Copy this file to .env and update values as needed

# Application settings
ITEM_ESTIMATOR_APP_NAME="Item Value Estimator"
ITEM_ESTIMATOR_DEBUG=false
ITEM_ESTIMATOR_LOG_LEVEL=INFO

# OpenAI key
ITEM_ESTIMATOR_OPENAI_API_KEY=sk-{your-openai-api-key}

# LangSmith settings
ITEM_ESTIMATOR_LANGSMITH_PROJECT=item-value-estimator
ITEM_ESTIMATOR_LANGSMITH_API_KEY={your-langsmith-api-key}
ITEM_ESTIMATOR_LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
